  "sources": [
    {
      "sourceId": "customer-balance",
      "category": "balance",
      "integrationMode": "adapter",
      "providerLabel": "customer-bank-api",
      "requiredFields": ["current_balance_cents", "available_balance_cents", "account_status", "currency"],
      "adapter": {
        "provider": "generic-rest",
        "baseUrl": "https://sandbox.api.customer.example",
        "allowedHosts": ["sandbox.api.customer.example"],
        "authProfile": "customerBalanceAuth",
        "mappingVersion": "balance-v1",
        "endpointPath": "/v1/accounts/{accountId}/balance",
        "method": "GET",
        "extract": {
          "eligibilityPath": "eligible",
          "scorePath": "score",
          "fields": {
            "currentBalanceCents": "current_balance_cents",
            "availableBalanceCents": "available_balance_cents",
            "accountStatus": "account_status",
            "currency": "currency"
          }
        },
        "auth": {
          "type": "oauth2-client-credentials",
          "tokenUrl": "https://sandbox.api.customer.example/oauth/token",
          "clientIdEnv": "CUSTOMER_BALANCE_CLIENT_ID",
          "clientSecretEnv": "CUSTOMER_BALANCE_CLIENT_SECRET",
          "scope": "accounts.read",
          "lifecycle": {
            "keyVersion": "customer-balance-sandbox-v1"
          }
        }
      }
    },
    {
      "sourceId": "customer-kyc",
      "category": "kyc",
      "integrationMode": "adapter",
      "providerLabel": "customer-identity-api",
      "requiredFields": ["kyc_status", "customer_id", "country_code"],
      "adapter": {
        "provider": "generic-rest",
        "baseUrl": "https://sandbox.identity.customer.example",
        "allowedHosts": ["sandbox.identity.customer.example"],
        "authProfile": "customerKycAuth",
        "mappingVersion": "kyc-v1",
        "endpointPath": "/v1/customers/{customerId}/kyc-status",
        "method": "GET",
        "extract": {
          "eligibilityPath": "eligible",
          "scorePath": "score",
          "fields": {
            "kycStatus": "kyc_status",
            "customerId": "customer_id",
            "countryCode": "country_code"
          }
        },
        "auth": {
          "type": "api-key",
          "secretEnv": "CUSTOMER_KYC_API_KEY",
          "header": "x-api-key",
          "lifecycle": {
            "keyVersion": "customer-kyc-sandbox-v1"
          }
        }
      }
    },
    {
      "sourceId": "custody-holdings",
      "category": "holdings",
      "integrationMode": "adapter",
      "providerLabel": "customer-custody-api",
      "requiredFields": ["asset_symbol", "units", "certificate_status", "account_id"],
