        "provider": "generic-rest",
        "baseUrl": "https://sandbox.custody.customer.example",
        "allowedHosts": ["sandbox.custody.customer.example"],
        "authProfile": "customerHoldingsAuth",
        "mappingVersion": "holdings-v1",
        "endpointPath": "/v1/accounts/{accountId}/positions/{securityId}",
        "method": "GET",
        "extract": {
          "eligibilityPath": "eligible",
          "scorePath": "score",
          "fields": {
            "assetSymbol": "asset_symbol",
            "units": "units",
            "certificateStatus": "certificate_status",
            "accountId": "account_id"
          }
        },
        "auth": {
          "type": "oauth2-client-credentials",
          "tokenUrl": "https://sandbox.custody.customer.example/oauth/token",
          "clientIdEnv": "CUSTOMER_HOLDINGS_CLIENT_ID",
          "clientSecretEnv": "CUSTOMER_HOLDINGS_CLIENT_SECRET",
          "scope": "holdings.read",
          "lifecycle": {
            "keyVersion": "customer-holdings-sandbox-v1"
          }
        }
